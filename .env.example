# Coordinator secret key (nsec or 64-hex). NEVER commit the real value.
# Prefer --secret-file or an env var in your shell over this file.
NOSTR_SECRET=nsec1...

# Optional relay override (comma-separated). Defaults match the client:
# wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net,wss://nostr.mom,wss://offchain.pub,wss://nostr-pub.wellorder.net
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net,wss://nostr.mom,wss://offchain.pub,wss://nostr-pub.wellorder.net
